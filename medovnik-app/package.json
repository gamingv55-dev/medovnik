{
  "name": "medovnik-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Медовник — приложение за домашна медовина: калкулатори, рецепти, наръчник, дневник на партидите.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
